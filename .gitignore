venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Data
*.csv
*.parquet
*.json
data/
raw_data/
processed_data/

# Models
*.pkl
*.h5
*.joblib
models/
mlruns/

# Logs
logs/
*.log

# Environment
.env
.env.local

# Airflow
airflow/logs/
airflow/dags/__pycache__/

# Kubernetes
k8s/kustomization.yaml
k8s/patches/

